# Generated by TradeForge v0.1.0 — UPI DEEMED-STATE RECONCILIATION
# Service: {{ service_name }} | Domain: payments
#
# DEEMED STATE: NPCI timed out. Payer bank debited. Payee unknown.
# RBI mandate:  Resolve within T+1 or reverse the debit.
#
# Three outcome cohorts:
#   COHORT 1 — reconciled : matched in NPCI file → mark SETTLED
#   COHORT 2 — timed_out  : not matched, age > 24h → trigger reversal
#   COHORT 3 — pending    : not matched, age <= 24h → retry next cycle
#
# SCHEDULE: Daily 11:45 PM IST (after NPCI file arrives at 11:30 PM)
# RBI EXCEPTION REPORT: Must be delivered by 09:00 AM IST next day

from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from datetime import date, timedelta
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("{{ service_name }}-reconciliation")

spark = SparkSession.builder \
    .appName("{{ service_name }}-upi-reconciliation") \
    .getOrCreate()

TODAY = date.today()
YESTERDAY = TODAY - timedelta(days=1)
SETTLEMENT_WINDOW_HOURS = 24  # RBI T+1 mandate

# ── LOAD DEEMED TRANSACTIONS ──────────────────────────────────────
deemed_df = spark.read \
    .format("jdbc") \
    .option("url", "jdbc:postgresql://${RDS_ENDPOINT}/transactions") \
    .option("dbtable", f"""
        (SELECT txn_ref_id, amount, vpa_payer, vpa_payee,
                ifsc_payee, status, created_at,
                EXTRACT(EPOCH FROM (NOW() - created_at))/3600 AS age_hours
         FROM upi_transactions
         WHERE status = 'DEEMED'
           AND DATE(created_at) = '{YESTERDAY}'
        ) AS deemed_txns
    """) \
    .option("user", "${DB_USER}") \
    .option("password", "${DB_PASSWORD}") \
    .load()

logger.info(f"Deemed transactions: {deemed_df.count()}")

# ── LOAD NPCI SETTLEMENT FILE ─────────────────────────────────────
# NPCI delivers pipe-delimited file daily at 11:30 PM IST
npci_df = spark.read \
    .format("csv") \
    .option("delimiter", "|") \
    .option("header", True) \
    .load("s3://{{ npci_settlement_path }}/date={TODAY}/settlement.dat")

logger.info(f"NPCI settlement records: {npci_df.count()}")

# ── THREE-COHORT RECONCILIATION ───────────────────────────────────

# COHORT 1: matched in NPCI → SETTLED
reconciled_df = deemed_df.join(
    npci_df.select("txn_ref_id", "status", "settled_amount"),
    on="txn_ref_id",
    how="inner"
)

# COHORT 2: not in NPCI + age > 24h → reversal required
timed_out_df = deemed_df.join(
    npci_df.select("txn_ref_id"),
    on="txn_ref_id",
    how="left_anti"
).filter(F.col("age_hours") > SETTLEMENT_WINDOW_HOURS)

# COHORT 3: not in NPCI + within 24h → hold, retry tomorrow
pending_df = deemed_df.join(
    npci_df.select("txn_ref_id"),
    on="txn_ref_id",
    how="left_anti"
).filter(F.col("age_hours") <= SETTLEMENT_WINDOW_HOURS)

logger.info(f"Reconciled: {reconciled_df.count()}")
logger.info(f"Timed out (reversal): {timed_out_df.count()}")
logger.info(f"Pending: {pending_df.count()}")

# ── WRITE COHORT OUTPUTS ──────────────────────────────────────────
reconciled_df.write.mode("append").parquet(
    f"s3://{{ s3_bucket }}/reconciliation/settled/date={TODAY}/"
)
timed_out_df.write.mode("append").parquet(
    f"s3://{{ s3_bucket }}/reconciliation/reversals/date={TODAY}/"
)
pending_df.write.mode("append").parquet(
    f"s3://{{ s3_bucket }}/reconciliation/pending/date={TODAY}/"
)

# ── RBI EXCEPTION REPORT ──────────────────────────────────────────
# Mandatory. Missing this by 09:00 AM is a regulatory breach.
rbi_report_df = timed_out_df.select(
    "txn_ref_id", "amount", "vpa_payer", "vpa_payee", "ifsc_payee", "created_at",
    F.lit("DEEMED_UNRESOLVED").alias("exception_type"),
    F.lit("REVERSAL_INITIATED").alias("action_taken"),
    F.current_timestamp().alias("report_generated_at")
)

rbi_report_df.write \
    .mode("overwrite") \
    .option("header", True) \
    .csv(f"s3://{{ rbi_exception_path }}/date={TODAY}/rbi_exception_report.csv")

logger.info(f"RBI exception report written. Reversals: {timed_out_df.count()}")